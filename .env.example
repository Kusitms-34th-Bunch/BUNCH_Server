# 로컬 개발 전용 기본값. 실제 비밀값은 커밋하지 않는다.
POSTGRES_DB=bunch
DB_URL=jdbc:postgresql://localhost:5432/bunch
DB_USERNAME=bunch
DB_PASSWORD=bunch_local
REDIS_HOST=localhost
REDIS_PORT=6379
# openssl rand -base64 64 결과를 입력한다.
JWT_SECRET=
# 아래 값은 앱 기동 확인용 placeholder이며 실제 로그인에는 사용할 수 없다.
APPLE_CLIENT_ID=test-apple-client
GOOGLE_CLIENT_ID=test-google-client
KAKAO_NATIVE_APP_KEY=test-kakao-client

# 앱에 포함된 승인 약관 본문의 실제 적용 버전. 미설정이면 약관 API는 503이다.
TERMS_SERVICE_VERSION=
TERMS_PRIVACY_VERSION=
TERMS_AGE_VERSION=
TERMS_DEMOGRAPHICS_VERSION=
# 사진 저장에만 필요. 실제 자격 증명은 로컬/배포 환경에 보관한다.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# 실제 앱/공개 웹 도메인으로 변경한다. 아래는 로컬 연동용이다.
BUNCH_INVITATION_BASE_URL=http://localhost:3000/invite
# Comma-separated browser origins allowed to open the STOMP WebSocket.
BUNCH_WS_ALLOWED_ORIGINS=http://localhost:3000
