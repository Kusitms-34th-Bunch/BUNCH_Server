# PostgreSQL 관리자 초기화. 앱 접속 계정과 구분한다.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD='CHANGE_POSTGRES_ADMIN_PASSWORD'

# CI가 게시하는 이미지와 같은 주소를 유지한다.
APP_IMAGE=ghcr.io/kusitms-34th-bunch/bunch_server:latest

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 아래 계정과 DB는 최초 한 번 직접 생성한다.
DB_URL=jdbc:postgresql://postgres:5432/bunch
DB_USERNAME=bunch
DB_PASSWORD='CHANGE_BUNCH_DB_PASSWORD'

REDIS_HOST=redis
REDIS_PORT=6379

# openssl rand 64 | openssl base64 -A 결과를 한 줄로 입력한다.
JWT_SECRET=''
APPLE_CLIENT_ID=''
GOOGLE_CLIENT_ID=''
KAKAO_NATIVE_APP_KEY=''

# 가입·온보딩 기능 배포 전에 실제 서비스 값으로 채운다.
TERMS_SERVICE_VERSION=''
TERMS_PRIVACY_VERSION=''
TERMS_AGE_VERSION=''
TERMS_DEMOGRAPHICS_VERSION=''
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''
BUNCH_INVITATION_BASE_URL=https://CHANGE_PUBLIC_DOMAIN/invite

TUNNEL_TOKEN=''

# 모니터링: 웹훅은 Grafana에만 전달한다. 예제 주소는 전송용이 아니다.
MONITORING_ENVIRONMENT=prod
GF_SERVER_ROOT_URL=https://grafana.example.com/
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD='CHANGE_GRAFANA_ADMIN_PASSWORD'
DISCORD_WEBHOOK_URL=https://discord.invalid/api/webhooks/example/example
