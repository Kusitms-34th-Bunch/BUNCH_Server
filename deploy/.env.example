# PostgreSQL 관리자 초기화. 앱 접속 계정과 구분한다.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD='CHANGE_POSTGRES_ADMIN_PASSWORD'

# CI가 게시하는 이미지와 같은 주소를 유지한다.
APP_IMAGE=ghcr.io/kusitms-34th-bunch/bunch_server:latest

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081

# 아래 계정과 DB는 최초 한 번 직접 생성한다.
DB_URL=jdbc:postgresql://postgres:5432/bunch
DB_USERNAME=bunch
DB_PASSWORD='CHANGE_BUNCH_DB_PASSWORD'

REDIS_HOST=redis
REDIS_PORT=6379

# openssl rand 64 | openssl base64 -A 결과를 한 줄로 입력한다.
JWT_SECRET=''
APPLE_CLIENT_ID=''
# 회원 탈퇴 때 Apple 연동을 철회하는 Sign in with Apple 키 값. 비워 두면 Apple 회원의 탈퇴가 거절된다.
# APPLE_PRIVATE_KEY는 .p8 파일 내용을 한 줄로 넣고 줄바꿈은 \n 으로 쓴다.
APPLE_TEAM_ID=''
APPLE_KEY_ID=''
APPLE_PRIVATE_KEY=''
GOOGLE_CLIENT_ID=''
KAKAO_NATIVE_APP_KEY=''

# 가입·온보딩 기능 배포 전에 실제 서비스 값으로 채운다.
TERMS_SERVICE_VERSION=''
TERMS_PRIVACY_VERSION=''
TERMS_AGE_VERSION=''
TERMS_DEMOGRAPHICS_VERSION=''
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''
ANTHROPIC_API_KEY=''
BUNCH_INVITATION_BASE_URL=https://CHANGE_PUBLIC_DOMAIN/invite

# 비워 두면 이미지에 번들된 금칙어 사전을 사용한다. 외부 사전을 쓸 때는
# 아래 컨테이너 경로와 실제 JSON 파일을 준비한 뒤 /app/profanity/dictionary.json을 지정한다.
# 기동 시 한 번만 읽는다. 파일 내용만 변경하면 docker compose restart app으로 반영한다.
# 경로 등 환경 변수를 변경하면 docker compose up -d --no-deps --force-recreate app으로 재생성한다.
PROFANITY_DICTIONARY_PATH=''
# Compose가 사용하는 호스트 디렉터리. 기존 서버 .env에 없어도 compose 기본값이 적용된다.
PROFANITY_DICTIONARY_MOUNT=./profanity

TUNNEL_TOKEN=''

# 모니터링: 같은 .env를 env_file로 읽는다. 예제 주소는 전송용이 아니다.
MONITORING_ENVIRONMENT=prod
GF_SERVER_ROOT_URL=https://grafana.example.com/
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD='CHANGE_GRAFANA_ADMIN_PASSWORD'
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_UNIFIED_ALERTING_MIN_INTERVAL=10s
DISCORD_WEBHOOK_URL=https://discord.invalid/api/webhooks/example/example
