# Reference values only. Inspect the existing project/volumes before adopting.
MONITORING_PROJECT=bunch
ALLOY_VOLUME=bunch_alloydata
LOKI_VOLUME=bunch_lokidata
PROMETHEUS_VOLUME=bunch_prometheusdata
GRAFANA_VOLUME=bunch_grafanadata
# Dedicated network only; never attach monitoring to dev DB/Redis network.
MONITORING_NETWORK=bunch-monitoring
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=example-not-a-real-password
GF_SERVER_ROOT_URL=https://grafana.example.invalid/
DISCORD_WEBHOOK_URL=http://127.0.0.1:9/api/webhooks/example/disabled
# Replace with the verified exact server version/digest; latest is forbidden.
MONITORING_TUNNEL_IMAGE=cloudflare/cloudflared:2026.10.0
MONITORING_TUNNEL_TOKEN=example-not-a-real-token
