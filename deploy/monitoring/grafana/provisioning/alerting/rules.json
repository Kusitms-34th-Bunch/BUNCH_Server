{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "bunch",
      "folder": "BUNCH",
      "interval": "10s",
      "rules": [
        {
          "uid": "bunch-http-5xx",
          "title": "BUNCH 5xx 발생",
          "condition": "B",
          "for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "BUNCH 5xx 발생",
            "__dashboardUid__": "bunch",
            "__panelId__": "3"
          },
          "labels": {
            "service": "bunch",
            "environment": "${MONITORING_ENVIRONMENT}",
            "severity": "critical",
            "monitoring_kind": "http5xx"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "refId": "A",
                "expr": "sum(count_over_time({service=\"bunch\"} |= \"[REQ END]\" |~ \" status=5[0-9]{2}( |$)\" [1m])) or vector(0)",
                "instant": true,
                "range": false,
                "queryType": "instant",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                }
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "bunch-app-down",
          "title": "BUNCH 앱 수집 중단",
          "condition": "B",
          "for": "1m",
          "noDataState": "KeepLast",
          "execErrState": "KeepLast",
          "isPaused": false,
          "annotations": {
            "summary": "BUNCH 앱 수집 중단",
            "__dashboardUid__": "bunch",
            "__panelId__": "1"
          },
          "labels": {
            "service": "bunch",
            "environment": "${MONITORING_ENVIRONMENT}",
            "severity": "critical",
            "monitoring_kind": "appdown"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "1 - (min(up{job=\"bunch\"}) or vector(0))",
                "instant": true,
                "range": false,
                "queryType": "instant",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                }
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
