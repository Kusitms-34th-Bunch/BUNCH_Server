{
  "uid": "bunch",
  "title": "BUNCH",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "Asia/Seoul",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment (logs)",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({service=\"bunch\"}, environment)",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "앱 수집 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"bunch\"}) or vector(0)",
          "legendFormat": "앱 수집 상태"
        }
      ]
    },
    {
      "id": 2,
      "title": "초당 요청 수",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"bunch\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "초당 요청 수"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx 응답 / 초",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"bunch\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx 응답 / 초"
        }
      ]
    },
    {
      "id": 4,
      "title": "응답 시간 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"bunch\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "응답 시간 p95"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM 힙 사용량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"bunch\",area=\"heap\"})",
          "legendFormat": "JVM 힙 사용량"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{job=\"bunch\",area=\"heap\"} > 0)",
          "legendFormat": "최대 힙"
        }
      ]
    },
    {
      "id": 6,
      "title": "Hikari 연결",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{job=\"bunch\"})",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{job=\"bunch\"})",
          "legendFormat": "유휴"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{job=\"bunch\"})",
          "legendFormat": "대기"
        }
      ]
    },
    {
      "id": 7,
      "title": "앱 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"bunch\",environment=\"$environment\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true
      }
    }
  ]
}
